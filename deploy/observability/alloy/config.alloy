logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "fundingpulse" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "fundingpulse_tracker_logs" {
  targets = discovery.docker.fundingpulse.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    action        = "keep"
    regex         = "tracker"
  }

  rule {
    target_label = "service"
    replacement  = "tracker"
  }
}

loki.source.docker "fundingpulse_tracker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.fundingpulse_tracker_logs.output
  forward_to = [loki.process.fundingpulse_tracker_logs.receiver]
}

loki.process "fundingpulse_tracker_logs" {
  stage.docker {}

  stage.json {
    expressions = {
      workflow        = "",
      domain_event    = "",
      level           = "",
      exchange        = "",
      instance_id     = "",
      logger          = "",
      component       = "",
      total_instances = "",
    }
  }

  stage.labels {
    values = {
      workflow    = "",
      event       = "domain_event",
      level       = "",
      exchange    = "",
      instance_id = "",
    }
  }

  stage.structured_metadata {
    values = {
      logger          = "",
      component       = "",
      total_instances = "",
    }
  }

  forward_to = [loki.write.fundingpulse.receiver]
}

loki.write "fundingpulse" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
